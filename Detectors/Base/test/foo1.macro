// File: slice_cone_localz_colored.C
//
// Run with:
//   root -l slice_cone_localz_colored.C
// or
//   .x slice_cone_localz_colored.C
//
// What it does:
//   - builds a cone whose radius grows toward +z in LOCAL coordinates
//   - places it in the mother with its axis along (1,1,1)
//   - slices it into M parts using local-z half-space cuts
//   - draws every slice as a separate colored volume
//   - computes an approximate mother-frame AABB for each slice by sampling
//     (no reliance on ComputeBBox() for the composite slice)

#include <vector>
#include <string>
#include <cmath>
#include <algorithm>
#include <iostream>

#include "TCanvas.h"
#include "TColor.h"
#include "TGeoBBox.h"
#include "TGeoBoolNode.h"
#include "TGeoCompositeShape.h"
#include "TGeoCone.h"
#include "TGeoHalfSpace.h"
#include "TGeoManager.h"
#include "TGeoMatrix.h"
#include "TGeoVolume.h"
#include "TMath.h"
#include "TPolyLine3D.h"

namespace {

std::vector<TObject*> gKeepAlive;
std::vector<TPolyLine3D*> gLines;

void Normalize(double v[3])
{
  const double n = std::sqrt(v[0]*v[0] + v[1]*v[1] + v[2]*v[2]);
  if (n <= 0.) return;
  v[0] /= n; v[1] /= n; v[2] /= n;
}

double Dot(const double a[3], const double b[3])
{
  return a[0]*b[0] + a[1]*b[1] + a[2]*b[2];
}

void BuildRotationZToDir(const double dir[3], TGeoRotation& rot)
{
  double ez[3] = {dir[0], dir[1], dir[2]};
  Normalize(ez);

  double ref[3] = {0., 0., 1.};
  if (std::fabs(Dot(ez, ref)) > 0.9) {
    ref[0] = 0.; ref[1] = 1.; ref[2] = 0.;
  }

  double ex[3] = {
    ref[1]*ez[2] - ref[2]*ez[1],
    ref[2]*ez[0] - ref[0]*ez[2],
    ref[0]*ez[1] - ref[1]*ez[0]
  };
  Normalize(ex);

  double ey[3] = {
    ez[1]*ex[2] - ez[2]*ex[1],
    ez[2]*ex[0] - ez[0]*ex[2],
    ez[0]*ex[1] - ez[1]*ex[0]
  };
  Normalize(ey);

  // columns = local axes in master frame
  double m[9] = {
    ex[0], ey[0], ez[0],
    ex[1], ey[1], ez[1],
    ex[2], ey[2], ez[2]
  };
  rot.SetMatrix(m);
}

void DrawBBoxWireframe(double xmin, double ymin, double zmin,
                       double xmax, double ymax, double zmax,
                       int color = kRed, int width = 1)
{
  double p[8][3] = {
    {xmin, ymin, zmin},
    {xmax, ymin, zmin},
    {xmax, ymax, zmin},
    {xmin, ymax, zmin},
    {xmin, ymin, zmax},
    {xmax, ymin, zmax},
    {xmax, ymax, zmax},
    {xmin, ymax, zmax}
  };

  int e[12][2] = {
    {0,1},{1,2},{2,3},{3,0},
    {4,5},{5,6},{6,7},{7,4},
    {0,4},{1,5},{2,6},{3,7}
  };

  for (int i = 0; i < 12; ++i) {
    auto l = new TPolyLine3D(2);
    l->SetPoint(0, p[e[i][0]][0], p[e[i][0]][1], p[e[i][0]][2]);
    l->SetPoint(1, p[e[i][1]][0], p[e[i][1]][1], p[e[i][1]][2]);
    l->SetLineColor(color);
    l->SetLineWidth(width);
    gLines.push_back(l);
    l->Draw();
  }
}

TGeoCompositeShape* MakeLocalZSlice(TGeoShape* baseShape,
                                    double z0,
                                    double z1,
                                    int islice)
{
  // Keep z >= z0  => half-space with outward normal (0,0,-1)
  double pLow[3] = {0., 0., z0};
  double nLow[3] = {0., 0., -1.};

  // Keep z <= z1  => half-space with outward normal (0,0,+1)
  double pHigh[3] = {0., 0., z1};
  double nHigh[3] = {0., 0., +1.};

  auto hsLow  = new TGeoHalfSpace(Form("hsLow_%d",  islice), pLow,  nLow);
  auto hsHigh = new TGeoHalfSpace(Form("hsHigh_%d", islice), pHigh, nHigh);
  gKeepAlive.push_back(hsLow);
  gKeepAlive.push_back(hsHigh);

  auto node1 = new TGeoIntersection(baseShape, hsLow);
  auto tmp   = new TGeoCompositeShape(Form("sliceTmp_%d", islice), node1);
  gKeepAlive.push_back(tmp);

  auto node2 = new TGeoIntersection(tmp, hsHigh);
  auto part  = new TGeoCompositeShape(Form("slice_%d", islice), node2);
  gKeepAlive.push_back(part);

  return part;
}

// Approximate mother AABB by sampling the LOCAL bounding box and testing Contains()
bool ApproxMotherAABBBySampling(TGeoShape* shape,
                                const TGeoMatrix* localToMother,
                                int nx, int ny, int nz,
                                double& xmin, double& ymin, double& zmin,
                                double& xmax, double& ymax, double& zmax)
{
  shape->ComputeBBox();
  auto box = dynamic_cast<TGeoBBox*>(shape);
  if (!box) return false;

  const double dx = box->GetDX();
  const double dy = box->GetDY();
  const double dz = box->GetDZ();
  const double* o = box->GetOrigin();

  xmin = ymin = zmin =  1e100;
  xmax = ymax = zmax = -1e100;

  bool found = false;
  double local[3], master[3];

  for (int ix = 0; ix < nx; ++ix) {
    const double x = o[0] - dx + (2.0*dx) * (ix + 0.5) / nx;
    for (int iy = 0; iy < ny; ++iy) {
      const double y = o[1] - dy + (2.0*dy) * (iy + 0.5) / ny;
      for (int iz = 0; iz < nz; ++iz) {
        const double z = o[2] - dz + (2.0*dz) * (iz + 0.5) / nz;

        local[0] = x; local[1] = y; local[2] = z;
        if (!shape->Contains(local)) continue;

        localToMother->LocalToMaster(local, master);

        xmin = std::min(xmin, master[0]);
        ymin = std::min(ymin, master[1]);
        zmin = std::min(zmin, master[2]);
        xmax = std::max(xmax, master[0]);
        ymax = std::max(ymax, master[1]);
        zmax = std::max(zmax, master[2]);
        found = true;
      }
    }
  }
  return found;
}

} // namespace

void slice_cone_localz_colored()
{
  // -----------------------
  // Controls
  // -----------------------
  const int M = 10;

  // sampling for approximate AABBs
  const int NSX = 18;
  const int NSY = 18;
  const int NSZ = 40;

  // -----------------------
  // Geometry setup
  // -----------------------
  auto geom = new TGeoManager("geom", "Cone sliced in local z");

  auto top = geom->MakeBox("TOP", nullptr, 350., 350., 350.);
  geom->SetTopVolume(top);

  // Cone in LOCAL coordinates:
  // dz, rmin1, rmax1, rmin2, rmax2
  // make it solid, narrow at -z and wide at +z
  const double dz    = 120.0;
  const double rLow  = 4.0;
  const double rHigh = 25.0;

  auto cone = new TGeoCone("baseCone", dz, 0.0, rLow, 0.0, rHigh);

  // Place local +Z along mother (1,1,1)
  double dir[3] = {1., 1., 1.};
  Normalize(dir);

  auto rot = new TGeoRotation();
  BuildRotationZToDir(dir, *rot);

  const double tx = 0.0, ty = 0.0, tz = 0.0;
  auto tr = new TGeoTranslation(tx, ty, tz);
  auto ct = new TGeoCombiTrans(*tr, *rot);

  // -----------------------
  // Build M local-z slices
  // -----------------------
  std::vector<TGeoVolume*> sliceVols;
  std::vector<TGeoCompositeShape*> sliceShapes;

  const double zminLocal = -dz;
  const double zmaxLocal = +dz;
  const double step = (zmaxLocal - zminLocal) / M;

  for (int i = 0; i < M; ++i) {
    const double z0 = zminLocal + i*step;
    const double z1 = (i == M-1) ? zmaxLocal : (zminLocal + (i+1)*step);

    auto sliceShape = MakeLocalZSlice(cone, z0, z1, i);
    sliceShapes.push_back(sliceShape);

    auto vol = new TGeoVolume(Form("SLICEVOL_%d", i), sliceShape);
    vol->SetLineColor(2 + (i % 7));
    vol->SetFillColor(2 + (i % 7));
    vol->SetTransparency(35);

    top->AddNode(vol, i + 1, ct);
    sliceVols.push_back(vol);
  }

  geom->CloseGeometry();

  // -----------------------
  // Draw colored slices
  // -----------------------
  auto c = new TCanvas("c", "Local-z sliced cone", 1200, 900);
  top->Draw("ogl");
  c->Update();

  // -----------------------
  // Approximate mother-frame AABBs from sampling
  // -----------------------
  for (int i = 0; i < M; ++i) {
    double xmin, ymin, zmin, xmax, ymax, zmax;
    const bool ok = ApproxMotherAABBBySampling(sliceShapes[i], ct,
                                               NSX, NSY, NSZ,
                                               xmin, ymin, zmin,
                                               xmax, ymax, zmax);
    if (!ok) continue;

    //DrawBBoxWireframe(xmin, ymin, zmin, xmax, ymax, zmax,
    //                  2 + (i % 7), 1);

    std::cout << "slice " << i
              << " local z in [" << (zminLocal + i*step) << ", "
              << ((i == M-1) ? zmaxLocal : (zminLocal + (i+1)*step)) << "]"
              << "  approx mother AABB = [("
              << xmin << ", " << ymin << ", " << zmin << ") -> ("
              << xmax << ", " << ymax << ", " << zmax << ")]\n";
  }

  c->Modified();
  c->Update();
}