void build_and_export(const char* out_root = "geom.root", bool check=true) {
  if (!gGeoManager) { new TGeoManager("geom","geom"); }
  TGeoVolume* top = build(check);
  gGeoManager->SetTopVolume(top);
  gGeoManager->CloseGeometry();
  gGeoManager->CheckOverlaps();
  gGeoManager->Export(out_root);
}
std::function<TGeoVolume*()> get_builder_hook_checked() {
  return []() { return build(true); };
}
std::function<TGeoVolume*()> get_builder_hook_unchecked() {
  return []() { return build(false); };
}